# Docker Compose Environment Variables
# Copy this file to .env and customize for your environment

# Application version (used for Docker build)
VERSION=dev
COMMIT=unknown
BUILD_DATE=

# BSV Broadcaster configuration via environment variables
# These override values in config.yaml

# Network: main, test, or stn
BSV_BROADCASTER_NETWORK=main

# Log level: debug, info, warn, error
BSV_BROADCASTER_LOG_LEVEL=info

# Teranode broadcast URLs (comma-separated)
# BSV_BROADCASTER_TERANODE_BROADCAST_URLS=https://arc.taal.com

# Server address (usually don't change this in Docker)
# BSV_BROADCASTER_SERVER_ADDRESS=:3011

# Authentication (if enabled)
# BSV_BROADCASTER_AUTH_ENABLED=false
# BSV_BROADCASTER_AUTH_TOKEN=your-secret-token

# Storage path (usually don't change this in Docker)
# BSV_BROADCASTER_STORAGE_PATH=/data
